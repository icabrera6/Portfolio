---
import { Picture } from 'astro:assets';
import pfp from '../assets/pfp.webp';
import { t, type Lang } from '../i18n';
import { heroChips, person } from '../data/site';

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const { hero } = t(lang);
---

<section id="hero" class="hero">
    <canvas class="hero-deck" aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
        <div class="hero-text">
            <span class="hero-kicker">{hero.kicker}</span>
            <h1>{person.name}</h1>
            <p class="hero-role">{hero.role}</p>
            <p class="hero-tagline muted">{hero.tagline}</p>
            <div class="chips">
                {heroChips.map((chip) => <span class="chip">{chip}</span>)}
            </div>
            <div class="cta-row">
                <a href="#contact" class="btn btn-primary">{hero.ctaContact}</a>
                <a href="#projects" class="btn btn-ghost">{hero.ctaProjects}</a>
            </div>
        </div>
        <div class="hero-photo">
            <!-- Photo inside the mark: the ring is the C, the gate lets the status out -->
            <div class="photo-ring">
                <svg class="ring" viewBox="0 0 120 120" aria-hidden="true">
                    <g class="ring-guides">
                        <circle cx="60" cy="60" r="57" stroke-dasharray="1.2 2.4"/>
                        <line x1="60" y1="-14" x2="60" y2="134"/>
                        <line x1="-14" y1="60" x2="96" y2="60"/>
                        <line x1="96" y1="48" x2="150" y2="48" stroke-dasharray="2 2"/>
                        <line x1="96" y1="72" x2="150" y2="72" stroke-dasharray="2 2"/>
                    </g>
                    <path class="ring-arc" d="M110.6 48 A52 52 0 1 0 110.6 72 L107.51 72 A49 49 0 1 1 107.51 48 Z"/>
                    <g class="ring-nodes"><circle cx="110.6" cy="48" r="1.3"/><circle cx="110.6" cy="72" r="1.3"/></g>
                </svg>
                <!-- Shown at 73.3% of the ring: min(300px, 74vw) on mobile, clamp(260px, 30vw, 400px) on desktop -->
                <Picture
                    src={pfp}
                    alt={hero.photoAlt}
                    widths={[220, 300, 440, 600]}
                    sizes="(max-width: 900px) min(220px, 54vw), clamp(191px, 22vw, 293px)"
                    formats={['avif']}
                    fallbackFormat="webp"
                    width={300}
                    height={300}
                    loading="eager"
                    fetchpriority="high"
                />
                <span class="photo-tag">{hero.status}</span>
            </div>
        </div>
    </div>
</section>
