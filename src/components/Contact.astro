---
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';
import { t, type Lang } from '../i18n';
import { cvPath, person } from '../data/site';

interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const { contact } = t(lang);
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<section id="contact" class="section contact">
    <div class="wrap">
        <div class="contact-panel">
            <svg class="contact-mark" viewBox="0 0 120 120" aria-hidden="true">
                <g class="cm-guides">
                    <circle cx="60" cy="60" r="52"/><circle cx="60" cy="60" r="36"/><circle cx="60" cy="60" r="44" stroke-dasharray="1 2"/>
                    <line x1="-40" y1="40" x2="160" y2="40" stroke-dasharray="2 1.5"/><line x1="-40" y1="80" x2="160" y2="80" stroke-dasharray="2 1.5"/>
                    <line x1="60" y1="-40" x2="60" y2="160"/><line x1="55" y1="-40" x2="55" y2="160" stroke-dasharray=".5 1.5"/>
                </g>
                <g class="cm-fill"><path d="M108 40 A52 52 0 1 0 108 80 L89.93 80 A36 36 0 1 1 89.93 40 Z"/><rect x="47" y="56" width="16" height="30"/><circle class="core" cx="55" cy="42.5" r="9"/></g>
            </svg>
            <SectionLabel index={5} text={contact.label} />
            <h2 class="h2">{contact.title}</h2>
            <p class="muted contact-sub">{contact.subtitle}</p>
            <div class="contact-grid">
                <a href={cvPath} download class="tcard contact-card">
                    <Icon name="fileText" />
                    <span class="t">{contact.cards.cv.title}</span>
                    <span class="d">{contact.cards.cv.detail}</span>
                </a>
                <a href={`mailto:${person.email}`} class="tcard contact-card">
                    <Icon name="mail" />
                    <span class="t">{contact.cards.email.title}</span>
                    <span class="d">{person.email}</span>
                </a>
                <a href={person.linkedin} {...external} class="tcard contact-card">
                    <Icon name="linkedin" />
                    <span class="t">{contact.cards.linkedin.title}</span>
                    <span class="d">{contact.cards.linkedin.detail}</span>
                </a>
                <a href={person.github} {...external} class="tcard contact-card">
                    <Icon name="github" />
                    <span class="t">{contact.cards.github.title}</span>
                    <span class="d">{contact.cards.github.detail}</span>
                </a>
            </div>
        </div>
    </div>
</section>
